# Keep the real key in .env. Never commit a real API key.
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=austin
# Optional verified server-side product catalog JSON; no prices are assumed by default.
GROQ_PRODUCT_CATALOG={}
# Optional HTTPS webhooks; schedule confirmation requires JSON {"booked":true}.
FOLLOWUP_WEBHOOK_URL=
CRM_WEBHOOK_URL=
INTEGRATION_WEBHOOK_SECRET=
PORT=3000
