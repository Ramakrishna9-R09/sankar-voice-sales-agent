# Open-model default: vLLM OpenAI-compatible endpoint; no per-token API key needed.
AI_PROVIDER=local
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=local-dev-key
LLM_MODEL=Qwen/Qwen3-8B-AWQ
# Optional hosted fallback. Keep credentials server-side and rotate any key that was pasted into a chat.
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=austin
# Hindi/Tamil/Telugu speech service; install and configure a consented reference voice in services/indic-tts.
TTS_PROVIDER=indicf5
INDIC_TTS_URL=http://127.0.0.1:8011
# Optional AI4Bharat Indic-TTS server supports Indian English and Hinglish as well as Indic voices.
AI4BHARAT_TTS_URL=
AI4BHARAT_TTS_GENDER=female
# Use one Hindi/English Qwen ASR worker and one Tamil/Telugu Whisper worker. The workers require a shared secret.
STT_PROVIDER=streaming
STT_WS_URL_HINDI=ws://127.0.0.1:8100/ws/transcribe
STT_WS_URL_TAMIL=ws://127.0.0.1:8101/ws/transcribe
STT_WS_URL_TELUGU=
VOICE_GATEWAY_SECRET=replace-with-a-random-secret-at-least-32-characters
# Optional local multilingual dense retrieval; lexical retrieval remains the instant fallback.
EMBEDDINGS_URL=http://127.0.0.1:8012
# energy is dependency-free; silero uses a locally served browser ONNX model/runtime.
VAD_PROVIDER=energy
EMBEDDING_REQUEST_TIMEOUT_MS=350
# Optional verified server-side product catalog JSON; no prices are assumed by default.
PRODUCT_CATALOG_JSON={}
# GROQ_PRODUCT_CATALOG is still accepted as a legacy alias.
# Optional small FAQ/policy index, e.g. [{"product":"Nexus CRM","kind":"policy","source":"approved-doc-17","content":"..."}]
SALES_KNOWLEDGE_JSON=[]
# Optional HTTPS webhooks; schedule confirmation requires JSON {"booked":true}.
FOLLOWUP_WEBHOOK_URL=
CRM_WEBHOOK_URL=
ORDER_STATUS_WEBHOOK_URL=
SUPPORT_TICKET_WEBHOOK_URL=
HUMAN_HANDOFF_WEBHOOK_URL=
INTEGRATION_WEBHOOK_SECRET=
PORT=3000
VOICE_LATENCY_TARGET_MS=800
